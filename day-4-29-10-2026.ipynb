   "source": [
    "def find_min(nums):\n",
    "    if len(nums) == 1:\n",
    "        return nums[0]\n",
    "    mid = len(nums) // 2\n",
    "    left = find_min(nums[:mid])\n",
    "    right = find_min(nums[mid:])\n",
    "    return min(left, right)\n",
    "\n",
    "print(find_min([5, 2, 7]))"
   ]
  }
